diff --git a/opl/opl.c b/opl/opl.c
index a1aa1d9..e6e71b7 100644
--- a/opl/opl.c
+++ b/opl/opl.c
@@ -471,6 +471,36 @@ static void DelayCallback(void *_delay_data)
     SDL_UnlockMutex(delay_data->mutex);
 }
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// In the browser the audio callback that fires DelayCallback runs on this same
+// thread, so blocking on the condition variable would freeze the page forever.
+// Yield to the event loop instead, and give up if audio is not running.
+// delay_data is static so a late callback never writes to a dead stack frame.
+void OPL_Delay(uint64_t us)
+{
+    static delay_data_t delay_data;
+    int waited_ms = 0;
+
+    if (driver == NULL)
+    {
+        return;
+    }
+
+    delay_data.finished = 0;
+    delay_data.mutex = NULL;
+    delay_data.cond = NULL;
+
+    OPL_SetCallback(us, DelayCallback, &delay_data);
+
+    while (!delay_data.finished && waited_ms < 250)
+    {
+        emscripten_sleep(1);
+        ++waited_ms;
+    }
+}
+#else
 void OPL_Delay(uint64_t us)
 {
     delay_data_t delay_data;
@@ -505,6 +535,7 @@ void OPL_Delay(uint64_t us)
     SDL_DestroyMutex(delay_data.mutex);
     SDL_DestroyCond(delay_data.cond);
 }
+#endif
 
 void OPL_SetPaused(int paused)
 {
